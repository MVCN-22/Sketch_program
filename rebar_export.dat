$ ---------------------------------------------------------------------------------------------------------------
$ Rebar Studio: SOFiSTiK's model and required reinforcement for the website, written by SOFiSTiK itself.
$ Put this file next to your .dat and add one line at the end of the .dat, after the design (BEMESS):
$     #INCLUDE rebar_export.dat
$ Every calculation then writes <project>.rebar.txt next to the .cdb. Open it on step 2 of the website
$ (Results > Open results). No Python, no Grasshopper. It only reads the database; nothing in it is changed.
$ Values are written as SOFiSTiK stores them: metres, radians and m2/m.
$ ---------------------------------------------------------------------------------------------------------------
+PROG TEMPLATE urs:990
HEAD Rebar Studio: results for the website
LET#CDB_IER 0
LET#CDB_LEN 0
<TEXT,FILE=$(PROJECT).rebar.txt>
REBAR-STUDIO 1 $(PROJECT)
</TEXT>
@KEY SYST
LET#10 @IPROB,@IACHS,@NKNOT,@MKNOT,@IGDIV
<TEXT,FILE=+$(PROJECT).rebar.txt>
S #(#14,10.0)
</TEXT>
LET#CDB_IER 0
@KEY GRP
LOOP
  LET#30 @NG,@(NG+1),@(NG+2),@(NG+3),@(NG+4)
  IF #CDB_IER<1
<TEXT,FILE=+$(PROJECT).rebar.txt>
G #(#30,8.0) #(#31,8.0) #(#32,8.0) #(#33,10.0) #(#34,10.0)
</TEXT>
  ENDIF
ENDLOOP #CDB_IER<2
LET#CDB_IER 0
@KEY NODE
LOOP
  LET#100 @NR,@(XYZ),@(XYZ+1),@(XYZ+2),@NR,@(XYZ), $$
      @(XYZ+1),@(XYZ+2),@NR,@(XYZ),@(XYZ+1),@(XYZ+2), $$
      @NR,@(XYZ),@(XYZ+1),@(XYZ+2),@NR,@(XYZ), $$
